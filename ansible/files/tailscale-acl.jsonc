// Tailscale ACL policy — managed via https://login.tailscale.com/admin/acls
// This file is a reference copy; Tailscale reads the policy from its admin console, not from disk.
{
    "tagOwners": {
        "tag:router":      ["autogroup:admin"],
        "tag:vps":         ["autogroup:admin"],
        "tag:workstation": ["autogroup:admin"],
        "tag:mobile":      ["autogroup:admin"],
        "tag:kvm":         ["autogroup:admin"],
    },

    "grants": [
        // Workstations -> routers, VPS, other workstations
        {
            "src": ["tag:workstation"],
            "dst": ["tag:router", "tag:vps", "tag:workstation"],
            "ip":  ["*"],
        },

        // Workstations -> home LAN via xndrei subnet router
        {
            "src": ["tag:workstation"],
            "dst": ["192.168.1.0/24", "192.168.2.0/24", "10.0.0.0/24"],
            "ip":  ["*"],
        },

        // Workstations -> Internet (exit node)
        {
            "src": ["tag:workstation"],
            "dst": ["autogroup:internet"],
            "ip":  ["*"],
        },

        // Mobile -> Internet only (exit node). No peer access.
        {
            "src": ["tag:mobile"],
            "dst": ["autogroup:internet"],
            "ip":  ["*"],
        },
        // Mobile -> Grafana web UI only (via xndrei subnet route). Keeps "stolen phone can't pivot".
        // NOTE: this subnet-route path is unreliable from the iPhone client (confirmed 2026-07-16 —
        // tcpdump on both the .20 host and the router's tailscale0 showed zero packets ever arriving,
        // across 5 retries, so the client isn't routing 192.168.1.0/24 traffic into the tunnel at all).
        // Left in place for reference/other clients, but do not rely on it for mobile.
        {
            "src": ["tag:mobile"],
            "dst": ["192.168.1.20"],
            "ip":  ["tcp:3000"],
        },
        // Mobile -> Nextcloud on .15 (direct Tailscale IP, no subnet-route dependency).
        {
            "src": ["tag:mobile"],
            "dst": ["100.81.37.72"],
            "ip":  ["tcp:80"],
        },
        // Mobile -> Grafana, reverse-proxied through .15 (nginx -> 192.168.1.20:3000 over LAN).
        // Avoids the xndrei subnet-route dependency the direct 192.168.1.20:3000 grant has.
        {
            "src": ["tag:mobile"],
            "dst": ["100.81.37.72"],
            "ip":  ["tcp:3000"],
        },
        // Mobile -> EveBox, reverse-proxied through .15 (nginx -> 192.168.1.20:8080 over LAN).
        // Same workaround as Grafana above — direct 192.168.1.20:8080 subnet-route grant doesn't
        // work from the iPhone (see note on that grant).
        {
            "src": ["tag:mobile"],
            "dst": ["100.81.37.72"],
            "ip":  ["tcp:8080"],
        },

        // VPS <-> VPS
        {
            "src": ["tag:vps"],
            "dst": ["tag:vps"],
            "ip":  ["*"],
        },

        // Workstations -> glkvm IP-KVM appliance only. No tag:kvm -> anything grant:
        // the device only needs to be reached, never to reach routers/VPS/workstations itself.
        {
            "src": ["tag:workstation"],
            "dst": ["tag:kvm"],
            "ip":  ["*"],
        },

        // Router <-> router (remove if bnp/xndrei should stay isolated)
        //{
        //    "src": ["tag:router"],
        //    "dst": ["tag:router"],
        //    "ip":  ["*"]
        //},

        // Mobile: no peer grants. Exit-node still works. Stolen phone can't pivot.
        // Routers/VPS cannot initiate to workstations — denied by default.
    ],

    // Workstations -> routers (bnp/xndrei) over Tailscale SSH, as root.
    // bnp's port 22 on its Tailscale IP is intercepted by Tailscale SSH, so this is the
    // only path to bnp now that its 192.168.1.0/24 subnet route is un-approved.
    // Scoped to tag:workstation (not autogroup:member) so no untagged device gets root.
    "ssh": [
        {
            "action": "accept",
            "src":    ["tag:workstation"],
            "dst":    ["tag:router"],
            "users":  ["root", "autogroup:nonroot"],
        },
        {
            "action":      "check",
            "src":         ["autogroup:member"],
            "dst":         ["tag:router", "tag:vps", "tag:workstation"],
            "users":       ["autogroup:nonroot"],
            "checkPeriod": "12h",
        },
    ],

    "autoApprovers": {
        "exitNode": ["autogroup:admin"],
        "routes": {
            "192.168.1.0/24": ["autogroup:admin"],
            "192.168.2.0/24": ["autogroup:admin"],
            "10.0.0.0/24":    ["autogroup:admin"],
        },
    },

    "tests": [
        {
            "src":    "tag:workstation",
            "accept": ["tag:router:22", "tag:vps:22", "tag:kvm:80", "1.1.1.1:443"],
        },
        {
            "src":  "tag:vps",
            "deny": ["tag:kvm:80"],
        },
        {
            "src":  "tag:router",
            "deny": ["tag:kvm:80"],
        },
        {
            "src":    "tag:mobile",
            "accept": ["192.168.1.20:3000", "100.81.37.72:80", "100.81.37.72:3000", "100.81.37.72:8080"],
            "deny": [
                "tag:workstation:22",
                "tag:router:22",
                "tag:vps:22",
                "192.168.1.20:22",
                "192.168.1.21:3000",
                "100.81.37.72:22",
            ],
        },
        {
            "src":  "tag:router",
            "deny": ["tag:workstation:22"],
        },
        {
            "src":  "tag:vps",
            "deny": ["tag:workstation:22"],
        },
    ],
    "nodeAttrs": [{"target": ["*"], "app": {"tailscale.com/app-connectors": []}}],
}
