#!/bin/bash
# Disk usage alert + self-remediation — managed by Ansible
# Was previously log-only (no alert reached anyone); now pushes Telegram and
# reclaims space at a critical threshold before the disk locks up (2026-05-30).
# No -e: remediation steps (curl/journalctl/find) are best-effort and guarded
# with `|| true`; a failed reclaim must not abort the post-check + alert.
set -uo pipefail
THRESHOLD={{ disk_alert_threshold }}
CRITICAL={{ disk_alert_critical }}
LOGFILE={{ disk_alert_log }}
TG_TOKEN="{{ telegram_bot_token }}"
TG_CHAT="{{ telegram_chat_id }}"
JOURNAL_FLOOR={{ disk_alert_journal_floor }}
HOST=$(hostname)

note() { echo "$(date '+%F %T') $1" >> "$LOGFILE"; logger -t disk-alert -p local0.warn "$1"; }
# $2 (priority) kept at call sites for readability but unused — Telegram has no priority header.
notify() {
    [ -z "$TG_TOKEN" ] && return 0
    curl -fsS -m 10 \
         --data-urlencode "chat_id=$TG_CHAT" \
         --data-urlencode "text=[SOC disk] $HOST: $1" \
         "https://api.telegram.org/bot$TG_TOKEN/sendMessage" >/dev/null 2>&1 || true
}

# Highest-used real filesystem
read -r pct mnt < <(df -h --output=pcent,target -x tmpfs -x devtmpfs | tail -n +2 | sort -rn | head -1)
val=${pct%%%}

if [ "$val" -ge "$CRITICAL" ]; then
    note "CRITICAL: $HOST $mnt at ${pct} (>= ${CRITICAL}%) — remediating"
    notify "CRITICAL: $mnt at ${pct} — auto-reclaiming space" urgent
    journalctl --vacuum-size="$JOURNAL_FLOOR" >/dev/null 2>&1 || true
    if [ -d /var/ossec/logs/archives ]; then
        find /var/ossec/logs/archives -type f \
            \( -name 'ossec-archive-*.json' -o -name 'ossec-archive-*.log' \) \
            -mtime +0 -exec gzip {} \; 2>/dev/null || true
    fi
    read -r pct2 _ < <(df -h --output=pcent,target -x tmpfs -x devtmpfs | tail -n +2 | sort -rn | head -1)
    note "post-remediation: $mnt now ${pct2}"
    notify "After reclaim: $mnt now ${pct2}" high
elif [ "$val" -ge "$THRESHOLD" ]; then
    msg="WARNING: $HOST $mnt at ${pct} (threshold ${THRESHOLD}%)"
    note "$msg"
    notify "$msg" high
fi
