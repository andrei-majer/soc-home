<!-- ================================================================
     Suricata EVE correlation rules (100100-100109)
     Base rule: 86601 fires on any Suricata alert (level 3)
     ================================================================ -->
<group name="local,ids,suricata,">

  <!-- Severity 1 (critical) Suricata alert → escalate to level 12 -->
  <rule id="100100" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.severity">^1$</field>
    <description>Suricata: Critical alert (sev1) - $(alert.signature)</description>
    <group>ids,suricata,high_severity,</group>
  </rule>

  <!-- Malware / C2 / Trojan category alerts → level 10 -->
  <rule id="100101" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.category">Malware|Trojan|Botnet|Command and Control|A Network Trojan</field>
    <description>Suricata: Malware/C2 alert - $(alert.signature)</description>
    <group>ids,suricata,malware,</group>
  </rule>

  <!-- iprep: known bad IP communicating with internal host → level 8 -->
  <rule id="100102" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.signature">IPREP</field>
    <description>Suricata: Known bad IP alert - $(alert.signature) src=$(src_ip)</description>
    <group>ids,suricata,iprep,threat_intel,</group>
  </rule>

  <!-- Exploit attempt categories → level 10 -->
  <rule id="100103" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.category">Attempted Administrator Privilege Gain|Attempted User Privilege Gain|Successful Administrator Privilege Gain|Web Application Attack|Exploit Kit Activity</field>
    <description>Suricata: Exploit attempt - $(alert.signature)</description>
    <group>ids,suricata,exploit,</group>
  </rule>

  <!-- Brute force / scan burst: 10+ alerts from same src in 60s → level 10 -->
  <rule id="100104" level="10" frequency="10" timeframe="60">
    <if_matched_sid>86601</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Suricata: Burst of alerts from $(src_ip) - possible active attack</description>
    <group>ids,suricata,attack_burst,</group>
  </rule>

  <!-- MISP IOC match → level 8 (known threat actor / active IOC) -->
  <rule id="100105" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.signature">^MISP</field>
    <description>Suricata: MISP IOC match - $(alert.signature)</description>
    <group>ids,suricata,misp,threat_intel,</group>
  </rule>

  <rule id="100030" level="10">
    <if_group>ids,suricata</if_group>
    <list field="data.src_ip" lookup="match_key">etc/lists/opencti-ioc</list>
    <description>Suricata: OpenCTI IOC match - src_ip $(data.src_ip)</description>
    <group>ids,suricata,opencti,threat_intel,soc-contain,</group>
  </rule>

  <rule id="100031" level="10">
    <if_group>ids,suricata</if_group>
    <list field="data.dest_ip" lookup="match_key">etc/lists/opencti-ioc</list>
    <description>Suricata: OpenCTI IOC match - dest_ip $(data.dest_ip)</description>
    <group>ids,suricata,opencti,threat_intel,soc-contain,</group>
  </rule>


  <!-- Sysmon EID 3: outbound connection to OpenCTI IOC IP -->
  <rule id="100040" level="10">
    <if_sid>61603</if_sid>
    <list field="data.win.eventdata.destinationIp" lookup="match_key">etc/lists/opencti-ioc</list>
    <description>Sysmon: outbound connection to OpenCTI IOC $(data.win.eventdata.destinationIp)</description>
    <group>sysmon,opencti,threat_intel,soc-contain,</group>
  </rule>

  <!-- Sysmon EID 22: DNS query for OpenCTI IOC domain -->
  <rule id="100041" level="10">
    <if_sid>61650</if_sid>
    <list field="data.win.eventdata.queryName" lookup="match_key">etc/lists/opencti-ioc</list>
    <description>Sysmon: DNS query for OpenCTI IOC domain $(data.win.eventdata.queryName)</description>
    <group>sysmon,opencti,threat_intel,soc-contain,</group>
  </rule>

</group>

<!-- ================= Zeek (lean Wazuh integration, 2026-05-31) =================
     Zeek notice.log + dns.log arrive from the .20 agent as JSON localfiles and
     are parsed by Wazuh's built-in JSON decoder (NO custom decoder). The bundled
     0635-owlh-zeek_rules.xml (66001-66004) is dead: it matches an obsolete
     'bro_engine' field absent from Zeek 8.x JSON. We alert on Zeek's curated
     notices and on NXDOMAIN bursts (DGA / DNS-exfil) that the ELK/Grafana path
     cannot alert on. Frequency rules MUST use <same_field>id.orig_h</same_field>
     (not <same_source_ip/>) because the JSON decoder keeps Zeek's literal dotted
     key id.orig_h and never maps it to srcip. -->
<group name="zeek,ids,">

  <!-- notice.log: every record has a top-level "note" (Suricata eve does not) -->
  <rule id="100200" level="5">
    <decoded_as>json</decoded_as>
    <field name="note" type="pcre2">.+</field>
    <description>Zeek notice: $(note)</description>
    <group>zeek_notice,</group>
  </rule>

  <!-- escalate high-severity notice classes -->
  <rule id="100201" level="10">
    <if_sid>100200</if_sid>
    <field name="note" type="pcre2">Intel::|Scan::|Invalid_Server_Cert|SSH::Password_Guessing|SSH::Login_By_Password_Guesser</field>
    <description>Zeek notice (high severity): $(note)</description>
    <group>zeek_notice,attack,</group>
  </rule>

  <!-- soc-contain: large outbound transfer -> exfil_volume (T1) -->
  <rule id="100202" level="10">
    <if_sid>100200</if_sid>
    <field name="note" type="pcre2">LargeTransfer::Large_Outbound</field>
    <description>Zeek: large outbound transfer (possible exfil) $(src) -> $(dst)</description>
    <group>zeek_notice,exfil_volume,soc-contain,</group>
  </rule>

  <!-- dns.log NXDOMAIN: Zeek-specific top-level qtype_name + rcode_name.
       Level 0 = silent base for correlation only (no per-query alert). -->
  <rule id="100210" level="0">
    <decoded_as>json</decoded_as>
    <field name="qtype_name" type="pcre2">.+</field>
    <field name="rcode_name" type="pcre2">^NXDOMAIN$</field>
    <description>Zeek DNS NXDOMAIN (silent base)</description>
    <group>zeek_dns,</group>
  </rule>

  <!-- NXDOMAIN burst from the same host within 60s -> DGA / DNS-exfil signal -->
  <rule id="100211" level="10" frequency="20" timeframe="60">
    <if_matched_sid>100210</if_matched_sid>
    <same_field>id.orig_h</same_field>
    <description>Zeek: NXDOMAIN burst from same host (possible DGA / DNS exfil)</description>
    <group>zeek_dns,attack,dns_tunnel,soc-contain,</group>
  </rule>

</group>

<!-- ================================================================
     Canary trip-wire rules (100300-100309) - internal lateral movement
     Spec: docs/specs/2026-06-01-canary-design.md
     Field paths confirmed via wazuh-logtest against real opencanary +
     sinkhole.py JSON: src_host/dst_host/dst_port at TOP LEVEL (NOT
     under logdata as initial spec assumed); logdata.USER nested for cred.
     ================================================================ -->
<group name="canary,internal_tripwire,">

  <!-- OpenCanary base: matches dst_host=.24 AND logtype present (sinkhole has
       no logtype field, only event=sinkhole_hit; this gate prevents 100300
       from firing on sinkhole events and letting 100306/307 chain instead). -->
  <rule id="100300" level="3">
    <decoded_as>json</decoded_as>
    <field name="dst_host">192.168.1.24</field>
    <field name="logtype" type="pcre2">^\d+$</field>
    <description>Canary hit on .24 (base, silent)</description>
  </rule>

  <!-- All source rules fire at their full alert level. Per-(rule,src) hourly
       dedup is handled by custom-ntfy script (DEDUP_WINDOW_SEC=3600), NOT
       by Wazuh correlation rules - the latter cannot fire on the first hit
       (frequency must be >= 2) which would miss single-shot probes.
       Rule 100303 (cred capture) is in the script's DEDUP_BYPASS_RULES set
       so every unique cred attempt always pages. -->

  <!-- LAN source + banner port (FTP/Telnet/HTTP/HTTPS) -->
  <rule id="100301" level="10">
    <if_sid>100300</if_sid>
    <field name="src_host" type="pcre2">^192\.168\.1\.</field>
    <field name="dst_port" type="pcre2">^(21|23|80|443)$</field>
    <description>Canary banner-port hit from LAN: $(src_host) -> :$(dst_port)</description>
    <group>canary_banner,soc-contain,</group>
  </rule>

  <!-- LAN source + critical port (SMB/MySQL/RDP/VNC) -->
  <rule id="100302" level="12">
    <if_sid>100300</if_sid>
    <field name="src_host" type="pcre2">^192\.168\.1\.</field>
    <field name="dst_port" type="pcre2">^(445|3306|3389|5900)$</field>
    <description>Canary critical-port hit from LAN: $(src_host) -> :$(dst_port)</description>
    <group>canary_critical,soc-contain,</group>
  </rule>

  <!-- Credential capture: OpenCanary logs logdata.USERNAME on failed FTP/Telnet/MySQL login.
       In DEDUP_BYPASS_RULES - every cred pair always pages. -->
  <rule id="100303" level="12">
    <if_sid>100300</if_sid>
    <field name="logdata.USERNAME" type="pcre2">.+</field>
    <description>Canary credential attempt captured on .24 (user=$(logdata.USERNAME))</description>
    <group>canary_creds,soc-contain,</group>
  </rule>

  <!-- Sinkhole base: event=sinkhole_hit; uses client_ip not src_host -->
  <rule id="100306" level="3">
    <decoded_as>json</decoded_as>
    <field name="event">^sinkhole_hit$</field>
    <description>Sinkhole hit on .24 (base, silent)</description>
  </rule>

  <!-- Sinkhole LAN source -->
  <rule id="100307" level="12">
    <if_sid>100306</if_sid>
    <field name="client_ip" type="pcre2">^192\.168\.1\.</field>
    <description>Sinkhole C2-port hit from LAN: $(client_ip) -> :$(dst_port)</description>
    <group>canary_critical,soc-contain,</group>
  </rule>

</group>

<!-- ================================================================
     T-Pot internal lateral-movement rules (100400-100409)
     Only LAN-source hits page - external internet noise stays in T-Pot
     Kibana on .23:64297, unchanged. Field paths confirmed empirically:
     Cowrie/Dionaea/Heralding/Honeytrap/Tanner all emit src_ip at TOP
     level. Cowrie uses eventid:cowrie.* prefix; others vary so the base
     rule matches by location field instead (Wazuh adds it automatically
     from the localfile path).
     Spec: docs/specs/2026-06-01-canary-design.md
     ================================================================ -->
<group name="tpot,internal_tripwire,">

  <!-- T-Pot honeypot base - matches decoded JSON events that have one of
       the honeypot signature fields. Each honeypot has a distinct top-level
       key after JSON decode: cowrie has eventid:cowrie.*, dionaea has
       connection.protocol, heralding has session_id, honeytrap has
       attacker, tanner has uuid+sess_uuid, elasticpot has http_user_agent.
       Initial attempt used <location> regex but real-time location filter
       does not honor pcre2 like wazuh-logtest does. -->
  <rule id="100400" level="3">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.</field>
    <description>T-Pot Cowrie hit (silent base)</description>
  </rule>

  <!-- LAN source - fires on FIRST hit. Per-(rule,src) dedup in custom-ntfy. -->
  <rule id="100401" level="12">
    <if_sid>100400</if_sid>
    <field name="src_ip" type="pcre2">^192\.168\.1\.</field>
    <description>T-Pot Cowrie lateral movement: $(src_ip) -> .23 SSH</description>
    <group>tpot,attack,</group>
  </rule>

  <!-- Honeytrap (generic TCP catch-all on .23 high ports). Decoded as
       attack_connection.remote_ip, .local_port, .protocol nested. -->
  <rule id="100402" level="3">
    <decoded_as>json</decoded_as>
    <field name="attack_connection.protocol" type="pcre2">.+</field>
    <description>T-Pot Honeytrap hit (silent base)</description>
  </rule>

  <rule id="100403" level="12">
    <if_sid>100402</if_sid>
    <field name="attack_connection.remote_ip" type="pcre2">^192\.168\.1\.</field>
    <description>T-Pot Honeytrap lateral movement: $(attack_connection.remote_ip) -> .23:$(attack_connection.local_port)</description>
    <group>tpot,attack,</group>
  </rule>

  <!-- Tanner (HTTP). Decoded as peer.ip / peer.port nested. -->
  <rule id="100404" level="3">
    <decoded_as>json</decoded_as>
    <field name="peer.ip" type="pcre2">.+</field>
    <field name="path" type="pcre2">.+</field>
    <description>T-Pot Tanner HTTP hit (silent base)</description>
  </rule>

  <rule id="100405" level="12">
    <if_sid>100404</if_sid>
    <field name="peer.ip" type="pcre2">^192\.168\.1\.</field>
    <description>T-Pot Tanner lateral movement: $(peer.ip) -> .23 HTTP $(method) $(path)</description>
    <group>tpot,attack,</group>
  </rule>

  <!-- Elasticpot (fake Elasticsearch :9200). Decoded as src_ip top-level + eventid:elasticpot.* -->
  <rule id="100406" level="3">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^elasticpot\.</field>
    <description>T-Pot Elasticpot hit (silent base)</description>
  </rule>

  <rule id="100407" level="12">
    <if_sid>100406</if_sid>
    <field name="src_ip" type="pcre2">^192\.168\.1\.</field>
    <description>T-Pot Elasticpot lateral movement: $(src_ip) -> .23:9200 $(eventid)</description>
    <group>tpot,attack,</group>
  </rule>

</group>
