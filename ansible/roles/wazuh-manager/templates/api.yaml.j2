# Wazuh API configuration — updated 2026-03-29

# Listen on all interfaces
host: ['0.0.0.0']
port: 55000

# HTTPS — TLS 1.2+ with strong ciphers only
https:
  enabled: yes
  key: 'server.key'
  cert: 'server.crt'
  use_ca: no
  ca: 'ca.crt'
  ssl_protocol: 'TLSv1.2'
  ssl_ciphers: 'ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256'

# Timeouts
intervals:
  request_timeout: 30

# Log with size cap to prevent disk fill
logs:
  level: 'info'
  format: 'plain'
  max_size:
    enabled: yes
    size: '50M'

# CORS disabled (internal network only)
cors:
  enabled: no

# Brute-force protection
access:
  max_login_attempts: 5
  block_time: 900
  max_request_per_minute: {{ wazuh_api_rate_limit }}

# Drop privileges
drop_privileges: yes

experimental_features: no

# 10 MB upload limit
max_upload_size: 10485760

authentication_pool_size: 2
