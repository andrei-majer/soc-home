[global]
   workgroup = WORKGROUP
   netbios name = {{ canary_smb_netbiosname }}
   server string = {{ canary_smb_serverstring }}
   security = user
   map to guest = bad user
   guest account = nobody
   server min protocol = SMB2
   server multi channel support = no
   load printers = no
   disable spoolss = yes
   show add printer wizard = no
   printcap name = /dev/null
   logging = file
   log file = /var/log/samba/log.%m
   max log size = 1000

   # OpenCanary integration: full_audit -> syslog local5.notice
   # rsyslog drop-in routes that to /var/log/samba-audit.log which
   # opencanary's SambaLogWatcher tails. Prefix matches the field layout
   # opencanary expects (user|srcIP|srcName|srcNetbios|share|server|
   # smbVersion|arch|timestamp|domain ; samba appends action|status|path).
   vfs objects = full_audit
   full_audit:prefix = %u|%I|%i|%m|%S|%h|%R|%a|%T|%D
   full_audit:success = all
   full_audit:failure = none
   full_audit:facility = LOCAL5
   full_audit:priority = NOTICE

{% for share in canary_smb_shares %}
[{{ share }}]
   path = {{ canary_smb_share_dir }}/{{ share }}
   browseable = yes
   read only = yes
   guest ok = yes
   force user = nobody

{% endfor %}
