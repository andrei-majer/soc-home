{
  "uid": "ssd-health-15",
  "title": "SSD Health — Hypervisor .15",
  "tags": ["ssd", "disk", "raid", "soc"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "${DS_LOKI}" },
        "hide": 2,
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "RAID md126 (root/home/vms)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"mdraid\", host=\"15\", array=\"md126\"} | logfmt healthy | unwrap healthy [$__interval])", "queryType": "range" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0,
        "mappings": [ { "type": "value", "options": { "0": { "text": "DEGRADED", "color": "red" }, "1": { "text": "OK", "color": "green" } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "RAID md127 (/boot)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"mdraid\", host=\"15\", array=\"md127\"} | logfmt healthy | unwrap healthy [$__interval])", "queryType": "range" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0,
        "mappings": [ { "type": "value", "options": { "0": { "text": "DEGRADED", "color": "red" }, "1": { "text": "OK", "color": "green" } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Life — sda (MX300 backup)",
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sda\"} | logfmt life_remaining_pct | unwrap life_remaining_pct [$__interval])", "queryType": "range" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 10 }, { "color": "green", "value": 25 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Life — sdb (SU800 RAID)",
      "gridPos": { "h": 4, "w": 5, "x": 13, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt life_remaining_pct | unwrap life_remaining_pct [$__interval])", "queryType": "range" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 10 }, { "color": "green", "value": 25 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Life — sdc (SU800 RAID)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt life_remaining_pct | unwrap life_remaining_pct [$__interval])", "queryType": "range" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 10 }, { "color": "green", "value": 25 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Temperature (now)",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sda",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sda\"} | logfmt temp_c | unwrap temp_c [$__interval])", "queryType": "range" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdb",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt temp_c | unwrap temp_c [$__interval])", "queryType": "range" },
        { "refId": "C", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdc",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt temp_c | unwrap temp_c [$__interval])", "queryType": "range" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "celsius", "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 55 }, { "color": "red", "value": 65 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Bad sectors — must stay 0 (realloc/pending/uncorrectable)",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sda",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sda\"} | logfmt reallocated, pending, uncorrectable | unwrap reallocated [$__interval]) + last_over_time({job=\"ssd\", host=\"15\", dev=\"sda\"} | logfmt pending | unwrap pending [$__interval]) + last_over_time({job=\"ssd\", host=\"15\", dev=\"sda\"} | logfmt uncorrectable | unwrap uncorrectable [$__interval])", "queryType": "range" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdb",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt reallocated | unwrap reallocated [$__interval]) + last_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt pending | unwrap pending [$__interval]) + last_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt uncorrectable | unwrap uncorrectable [$__interval])", "queryType": "range" },
        { "refId": "C", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdc",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt reallocated | unwrap reallocated [$__interval]) + last_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt pending | unwrap pending [$__interval]) + last_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt uncorrectable | unwrap uncorrectable [$__interval])", "queryType": "range" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Life Remaining %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sda (MX300 backup)",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sda\"} | logfmt life_remaining_pct | unwrap life_remaining_pct [$__interval])", "queryType": "range" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdb (SU800 RAID)",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt life_remaining_pct | unwrap life_remaining_pct [$__interval])", "queryType": "range" },
        { "refId": "C", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdc (SU800 RAID)",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt life_remaining_pct | unwrap life_remaining_pct [$__interval])", "queryType": "range" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Temperature",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sda",
          "expr": "avg_over_time({job=\"ssd\", host=\"15\", dev=\"sda\"} | logfmt temp_c | unwrap temp_c [$__interval])", "queryType": "range" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdb",
          "expr": "avg_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt temp_c | unwrap temp_c [$__interval])", "queryType": "range" },
        { "refId": "C", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdc",
          "expr": "avg_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt temp_c | unwrap temp_c [$__interval])", "queryType": "range" }
      ],
      "fieldConfig": { "defaults": { "unit": "celsius", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Total Bytes Written (TB)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sda",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sda\"} | logfmt tbw_tb | unwrap tbw_tb [$__interval])", "queryType": "range" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdb",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt tbw_tb | unwrap tbw_tb [$__interval])", "queryType": "range" },
        { "refId": "C", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdc",
          "expr": "last_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt tbw_tb | unwrap tbw_tb [$__interval])", "queryType": "range" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 1, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Error sectors + CRC — must stay 0 (realloc / pending / uncorrectable / crc)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sda reallocated",
          "expr": "max_over_time({job=\"ssd\", host=\"15\", dev=\"sda\"} | logfmt reallocated | unwrap reallocated [$__interval])", "queryType": "range" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sda uncorrectable",
          "expr": "max_over_time({job=\"ssd\", host=\"15\", dev=\"sda\"} | logfmt uncorrectable | unwrap uncorrectable [$__interval])", "queryType": "range" },
        { "refId": "C", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdb reallocated",
          "expr": "max_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt reallocated | unwrap reallocated [$__interval])", "queryType": "range" },
        { "refId": "D", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdb uncorrectable",
          "expr": "max_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt uncorrectable | unwrap uncorrectable [$__interval])", "queryType": "range" },
        { "refId": "E", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdb crc",
          "expr": "max_over_time({job=\"ssd\", host=\"15\", dev=\"sdb\"} | logfmt crc_errors | unwrap crc_errors [$__interval])", "queryType": "range" },
        { "refId": "F", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdc reallocated",
          "expr": "max_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt reallocated | unwrap reallocated [$__interval])", "queryType": "range" },
        { "refId": "G", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdc uncorrectable",
          "expr": "max_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt uncorrectable | unwrap uncorrectable [$__interval])", "queryType": "range" },
        { "refId": "H", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "sdc crc",
          "expr": "max_over_time({job=\"ssd\", host=\"15\", dev=\"sdc\"} | logfmt crc_errors | unwrap crc_errors [$__interval])", "queryType": "range" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "spanNulls": true } },
        "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "RAID degraded state (0 = healthy)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "md126 degraded",
          "expr": "max_over_time({job=\"mdraid\", host=\"15\", array=\"md126\"} | logfmt degraded | unwrap degraded [$__interval])", "queryType": "range" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "legendFormat": "md127 degraded",
          "expr": "max_over_time({job=\"mdraid\", host=\"15\", array=\"md127\"} | logfmt degraded | unwrap degraded [$__interval])", "queryType": "range" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "max": 2, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } },
        "overrides": [] }
    }
  ]
}
