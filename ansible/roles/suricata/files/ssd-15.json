{
  "uid": "ssd-health-15",
  "title": "SSD Health — Hypervisor .15",
  "description": "SMART + mdraid health for .15. Source: ssd-smart-loki-push.sh on .15 (10-min timer) -> Loki on .20. Loki retention ~7 d. Topology since 2026-08-19: sda+sdb = 250 GB Crucial backup RAID1, sdc+sdd = SU800 main RAID1.",
  "tags": [
    "ssd",
    "disk",
    "raid",
    "soc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5m",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "${DS_LOKI}"
        },
        "hide": 2,
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "RAID arrays",
      "description": "One box per md array, labeled by its /dev/md/<name> symlink (md NUMBERS shuffle across reboots - never trust mdN). backup = 2x250GB Crucial -> /mnt/backup; md0-root = 2xSU800 -> LUKS+LVM / + /home + /mnt/vms; md0-boot = /boot.",
      "gridPos": {
        "h": 4,
        "w": 7,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "last_over_time({job=\"mdraid\", host=\"15\", name=~\".+\"} | logfmt healthy | unwrap healthy [1h])",
          "queryType": "instant",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "DEGRADED",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Life remaining",
      "description": "sda=MX500, sdb=MX200 (backup RAID) / sdc, sdd=SU800 (main RAID). Crucial: attr 202 normalized. SU800: attr 169 RAW is the percentage.",
      "gridPos": {
        "h": 4,
        "w": 9,
        "x": 7,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "last_over_time({job=\"ssd\", host=\"15\"} | logfmt life_remaining_pct | unwrap life_remaining_pct [1h])",
          "queryType": "instant",
          "legendFormat": "{{dev}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bad sectors — must stay 0",
      "description": "Worst value across all four disks. Any non-zero -> check the Error sectors panel below for which disk. (CRC errors are tracked there, not here - sdc carries a historical benign CRC=1.)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "max(last_over_time({job=\"ssd\", host=\"15\"} | logfmt reallocated | unwrap reallocated [1h]))",
          "queryType": "instant",
          "legendFormat": "reallocated"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "max(last_over_time({job=\"ssd\", host=\"15\"} | logfmt pending | unwrap pending [1h]))",
          "queryType": "instant",
          "legendFormat": "pending"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "max(last_over_time({job=\"ssd\", host=\"15\"} | logfmt uncorrectable | unwrap uncorrectable [1h]))",
          "queryType": "instant",
          "legendFormat": "uncorrectable"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Life remaining %",
      "description": "Auto-scaled axis so single-percent moves are visible (SU800s: 100->95 in Jul, 95->94 in Aug - under watch, see Erase count panel).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "last_over_time({job=\"ssd\", host=\"15\"} | logfmt life_remaining_pct | unwrap life_remaining_pct [15m])",
          "queryType": "range",
          "legendFormat": "{{dev}} · {{model}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 7200000,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperature",
      "description": "smartd alerts at 60 C (warn) / 70 C (crit) - dashed lines match.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "avg_over_time({job=\"ssd\", host=\"15\"} | logfmt temp_c | unwrap temp_c [15m])",
          "queryType": "range",
          "legendFormat": "{{dev}} · {{model}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 7200000,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 70
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Erase count — SU800 wear-slope watch",
      "description": "SU800 attr 167 (avg erase), Crucial attr 173. OPEN WATCH (re-measure ~2026-08-27): SU800 life% is derived from erase count, not host writes. Erase climbing while TBW (next panel) stays flat = write amplification - leading suspect was VirtualBox discard=off; still pending on Suricata + ELK VMs.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "last_over_time({job=\"ssd\", host=\"15\"} | logfmt erase_count | unwrap erase_count [15m])",
          "queryType": "range",
          "legendFormat": "{{dev}} · {{model}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 7200000,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Host writes (TBW)",
      "description": "Crucial: attr 246 (LBAs x512 B). SU800: attr 241 (x32 MiB). sdb MX200 arrives with 27+ TB of prior life - that is history, not current churn; watch the slope.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "last_over_time({job=\"ssd\", host=\"15\"} | logfmt tbw_tb | unwrap tbw_tb [15m])",
          "queryType": "range",
          "legendFormat": "{{dev}} · {{model}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: TB",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 7200000,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error sectors + CRC — must stay flat",
      "description": "sdc (SU800) has a historical UDMA_CRC=1 - one SATA blip, benign while it stays at 1. Investigate any INCREASE (cable/backplane), and any non-zero realloc/pending/uncorr.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "max_over_time({job=\"ssd\", host=\"15\"} | logfmt reallocated | unwrap reallocated [15m])",
          "queryType": "range",
