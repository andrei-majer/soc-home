    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RAID degraded (0 = healthy)",
      "description": "Per-array degraded flag, labeled by array NAME (md numbers shuffle across reboots). The monthly scrub (~00:36, sync_action=check) is routine and does NOT set degraded.",
