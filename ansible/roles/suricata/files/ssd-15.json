        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "max_over_time({job=\"ssd\", host=\"15\"} | logfmt pending | unwrap pending [15m])",
