# MISP false positives — overly broad IOC rules (misp_ioc: /) matching benign traffic
# MISP e1257 Outgoing URL / — fires on Firefox captive portal checks
suppress gen_id 1, sig_id 6676221

# Host-specific suppressions
suppress gen_id 1, sig_id 2022918, track by_src, ip 192.168.1.13
suppress gen_id 1, sig_id 2042936, track by_src, ip 192.168.1.13
# ET P2P BitTorrent DHT ping request — background DHT traffic from workstation (.13)
suppress gen_id 1, sig_id 2008581, track by_src, ip 192.168.1.13

# Global suppressions (Noisy rules you never want to see)
suppress gen_id 1, sig_id 2210044
suppress gen_id 1, sig_id 2210045
suppress gen_id 1, sig_id 2210050

# Rate-limiting (Only see this once a minute)
# Remove the 'suppress' for 2100498 if you use this!
#threshold gen_id 1, sig_id 2100498, type limit, track by_src, count 1, seconds 60

