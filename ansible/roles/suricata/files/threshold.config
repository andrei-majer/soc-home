# IPREP scanner rule (sid:9000008) — CINS has 15k IPs; throttle to 1 alert per
# source IP per 60 seconds to prevent alert storms from active scanners
threshold gen_id 1, sig_id 9000008, type threshold, track by_src, count 1, seconds 60

# IPREP low-confidence malware outbound (sid:9000006) — throttle to reduce noise
# from ET Block CIDRs; 1 alert per destination IP per 300 seconds
threshold gen_id 1, sig_id 9000006, type threshold, track by_dst, count 1, seconds 300

# Local IoT rules — throttle to 1 alert per source per hour (keep visibility, kill storms)
threshold gen_id 1, sig_id 1000001, type threshold, track by_src, count 1, seconds 3600
threshold gen_id 1, sig_id 1000002, type threshold, track by_src, count 1, seconds 3600

# === 2026-04-13 EveBox triage suppressions ===
# MISP e1385 — public DNS resolvers (1.1.1.1, 8.8.8.8) wrongly listed as IOCs.
# Permanent fix: edit MISP event 1385 to remove public DNS, or add to warninglist.
suppress gen_id 1, sig_id 6906081
suppress gen_id 1, sig_id 6905801
# MISP e1303 / e1381 — link-local / cloud metadata IP 169.254.169.254
suppress gen_id 1, sig_id 6721771
suppress gen_id 1, sig_id 6903131
# MISP e660 — Microsoft Bing IP 204.79.197.203
suppress gen_id 1, sig_id 5484811
# MISP e1150 — api.ipify.org (legit IP-lookup, used by T-Pot sensor .125)
suppress gen_id 1, sig_id 6371281
suppress gen_id 1, sig_id 6371282
suppress gen_id 1, sig_id 6371283

# SSLBL JA3 'CoinMiner' 40adfd923eb82b89d8836ba37a19bca1 — Go default TLS client.
# Used by gh, kubectl, terraform, claude-code, etc. Scoped to dev workstation .13
# so a real miner on any other host would still alert.
suppress gen_id 1, sig_id 906200068, track by_src, ip 192.168.1.13

# ET DOS Possible SSDP Amplification Scan — Windows .13 doing normal SSDP discovery
# to router :1900. LAN→LAN, not a DoS.
suppress gen_id 1, sig_id 2019102, track by_src, ip 192.168.1.13

# ET SCAN Potential SSH Scan OUTBOUND — git push / gh CLI to GitHub from .13
suppress gen_id 1, sig_id 2003068, track by_src, ip 192.168.1.13

# ET FILE_SHARING files.pythonhosted.org — pip/uv downloads from .13
suppress gen_id 1, sig_id 2049201, track by_src, ip 192.168.1.13

# ET DNS Query for .to TLD — informational, low value, not actionable
suppress gen_id 1, sig_id 2027757

# GPL P2P BitTorrent transfer — intentional torrenting from workstation .13
suppress gen_id 1, sig_id 2102181, track by_src, ip 192.168.1.13
