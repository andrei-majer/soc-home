{
  "uid": "suricata-cdc",
  "title": "Suricata — Cyber Defense Operations",
  "description": "State-of-the-art CDC dashboard: threat posture, alert analytics, threat actors, geographic intelligence, application-layer visibility and live event feeds.",
  "tags": ["suricata", "ids", "cdc", "threat"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "panels": [

    { "id": 1, "type": "row", "title": "🛡️  THREAT POSTURE", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    {
      "id": 2, "type": "stat", "title": "Total Alerts",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(count_over_time({job=\"suricata\", event_type=\"alert\"}[$__range]))", "instant": true, "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] } } }
    },
    {
      "id": 3, "type": "stat", "title": "High Severity (Sev 1)",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(count_over_time({job=\"suricata\", event_type=\"alert\", severity=\"1\"}[$__range]))", "instant": true, "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] } } }
    },
    {
      "id": 4, "type": "stat", "title": "Medium Severity (Sev 2)",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(count_over_time({job=\"suricata\", event_type=\"alert\", severity=\"2\"}[$__range]))", "instant": true, "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "orange", "value": 100 }] } } }
    },
    {
      "id": 5, "type": "stat", "title": "Unique Signatures Fired",
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "count(sum by (alert_signature) (count_over_time({job=\"suricata\", event_type=\"alert\"} | json | alert_signature != \"\" [$__range])))", "instant": true, "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 100 }] } } }
    },
    {
      "id": 6, "type": "stat", "title": "Anomaly Events",
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(count_over_time({job=\"suricata\", event_type=\"anomaly\"}[$__range]))", "instant": true, "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 500 }] } } }
    },
    {
      "id": 7, "type": "stat", "title": "Total Network Events",
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(count_over_time({job=\"suricata\"}[$__range]))", "instant": true, "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "text", "value": 0 }] } } }
    },

    { "id": 10, "type": "row", "title": "📊  ALERT TIMELINE & SEVERITY", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 } },

    {
      "id": 11, "type": "timeseries", "title": "Alert Rate by Severity",
      "description": "Alerts per minute broken down by Suricata severity level (1=High, 2=Medium, 3=Low)",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 5 },
      "targets": [
        { "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(rate({job=\"suricata\", event_type=\"alert\", severity=\"1\"}[$__interval]))", "legendFormat": "Severity 1 — High" },
        { "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(rate({job=\"suricata\", event_type=\"alert\", severity=\"2\"}[$__interval]))", "legendFormat": "Severity 2 — Medium" },
        { "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(rate({job=\"suricata\", event_type=\"alert\", severity=\"3\"}[$__interval]))", "legendFormat": "Severity 3 — Low" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "none" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Severity 1 — High" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Severity 2 — Medium" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Severity 3 — Low" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12, "type": "piechart", "title": "Severity Distribution",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "targets": [
        { "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(count_over_time({job=\"suricata\", event_type=\"alert\", severity=\"1\"}[$__range]))", "instant": true, "refId": "A", "legendFormat": "Severity 1 — High" },
        { "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(count_over_time({job=\"suricata\", event_type=\"alert\", severity=\"2\"}[$__range]))", "instant": true, "refId": "B", "legendFormat": "Severity 2 — Medium" },
        { "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "sum(count_over_time({job=\"suricata\", event_type=\"alert\", severity=\"3\"}[$__range]))", "instant": true, "refId": "C", "legendFormat": "Severity 3 — Low" }
      ],
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [{ "id": "displayName", "value": "Severity 1 — High" }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [{ "id": "displayName", "value": "Severity 2 — Medium" }, { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byFrameRefID", "options": "C" }, "properties": [{ "id": "displayName", "value": "Severity 3 — Low" }, { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] }
        ]
      },
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } }
    },

    { "id": 20, "type": "row", "title": "🎯  TOP THREATS", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 } },

    {
      "id": 21, "type": "table", "title": "Top 20 Signatures",
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 14 },
      "targets": [{ "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "topk(20, sum by (alert_signature) (count_over_time({job=\"suricata\", event_type=\"alert\"} | json | alert_signature != \"\" [$__range])))", "instant": true, "legendFormat": "{{alert_signature}}" }],
      "options": { "sortBy": [{ "displayName": "Hits", "desc": true }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Time" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "alert_signature" }, "properties": [{ "id": "displayName", "value": "Signature" }, { "id": "custom.width", "value": 480 }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Hits" }, { "id": "custom.displayMode", "value": "color-background" }, { "id": "color", "value": { "mode": "continuous-RdYlGr" } }, { "id": "custom.width", "value": 100 }] }
        ]
      },
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "alert_signature" } },
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ]
    },
    {
      "id": 22, "type": "table", "title": "Top Alert Categories",
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 14 },
      "targets": [{ "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" }, "expr": "topk(15, sum by (alert_category) (count_over_time({job=\"suricata\", event_type=\"alert\"} | json | alert_category != \"\" [$__range])))", "instant": true, "legendFormat": "{{alert_category}}" }],
      "options": { "sortBy": [{ "displayName": "Count", "desc": true }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Time" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "alert_category" }, "properties": [{ "id": "displayName", "value": "Category" }, { "id": "custom.width", "value": 300 }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Count" }, { "id": "custom.displayMode", "value": "lcd-gauge" }, { "id": "color", "value": { "mode": "continuous-BlYlRd" } } ] }
        ]
