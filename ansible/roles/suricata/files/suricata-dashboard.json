{
  "title": "Suricata IDS Alerts",
  "uid": "suricata-ids",
  "tags": ["suricata", "ids", "security"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Alert Rate (per minute)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum(rate({job=\"suricata\", event_type=\"alert\"}[1m]))",
          "legendFormat": "alerts/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      }
    },
    {
      "id": 2,
      "title": "Alerts by Severity",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum by (severity) (count_over_time({job=\"suricata\", event_type=\"alert\"}[6h]))",
          "legendFormat": "Severity {{severity}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Alerts by Protocol",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum by (proto) (count_over_time({job=\"suricata\", event_type=\"alert\"}[6h]))",
          "legendFormat": "{{proto}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total Alerts (6h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum(count_over_time({job=\"suricata\", event_type=\"alert\"}[6h]))",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Event Types (6h)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum by (event_type) (count_over_time({job=\"suricata\"}[6h]))",
          "legendFormat": "{{event_type}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Alert Rate by Severity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum by (severity) (rate({job=\"suricata\", event_type=\"alert\"}[5m]))",
          "legendFormat": "Severity {{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 7,
      "title": "Alert Log",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "{job=\"suricata\", event_type=\"alert\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 8,
      "title": "Full EVE Log (all event types)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 36 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "{job=\"suricata\"} | json | event_type != \"stats\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      }
    },
    {
      "id": 9,
      "title": "Top JA4 TLS Fingerprints",
      "description": "JA4 client fingerprints — identify TLS implementations and malware C2 frameworks. Added 2026-02-28.",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "topk(15, sum by (tls_ja4) (count_over_time({job=\"suricata\", event_type=\"tls\"} | json | tls_ja4 != \"\" [6h])))",
          "instant": true,
          "legendFormat": "{{tls_ja4}}"
        }
      ],
      "options": { "sortBy": [{ "displayName": "Count", "desc": true }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Time" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "tls_ja4" }, "properties": [{ "id": "displayName", "value": "JA4 Fingerprint" }, { "id": "custom.width", "value": 260 }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Count" }, { "id": "custom.displayMode", "value": "color-background" }, { "id": "color", "value": { "mode": "continuous-BlPu" } }] }
        ]
      },
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "tls_ja4" } },
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ]
    },
    {
      "id": 10,
      "title": "Top HASSH SSH Client Fingerprints",
      "description": "SSH client HASSH hashes — identifies SSH implementations. Known bad: Metasploit (ec7378c1a92f5a8dde7e8b7a1ddf33d1), Paramiko, Cobalt Strike. Added 2026-02-28.",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "topk(10, sum by (ssh_client_hassh_hash) (count_over_time({job=\"suricata\", event_type=\"ssh\"} | json | ssh_client_hassh_hash != \"\" [6h])))",
          "instant": true,
          "legendFormat": "{{ssh_client_hassh_hash}}"
        }
      ],
      "options": { "sortBy": [{ "displayName": "Sessions", "desc": true }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Time" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "ssh_client_hassh_hash" }, "properties": [{ "id": "displayName", "value": "HASSH Hash" }, { "id": "custom.width", "value": 240 }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Sessions" }, { "id": "custom.displayMode", "value": "color-background" }, { "id": "color", "value": { "mode": "continuous-GrYlRd" } }] }
        ]
      },
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "ssh_client_hassh_hash" } },
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ]
    }
  ]
}
