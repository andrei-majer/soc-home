# Managed by Ansible
[default]
# Elasticsearch on 192.168.1.21
elasticsearch={{ arkime_elasticsearch_host }}

# Index rotation
rotateIndex=daily

# Cron queries processed on this node
cronQueries=true

# Password hash secret (keep this secret, changing it invalidates all passwords)
passwordSecret={{ vault_arkime_password_secret }}

# HTTP realm and auth mode
httpRealm=Arkime
authMode=digest

# Capture interface (SPAN/mirror port)
interface={{ suricata_capture_interface }}

# PCAP storage
pcapDir=/opt/arkime/raw

# Max pcap file size (GB)
maxFileSizeG=4
# Reaper keeps this % of the disk free — safety bound for on-demand capture
# windows so a left-running capture can't fill / (was 3G ≈ 92% on a 39G disk).
freeSpaceG=25%

# snapLen must exceed the largest frame. The virtio SPAN NIC's hardware GRO
# (rx-gro-hw is [fixed], can't be disabled) coalesces RX frames well past the
# 1500 MTU, so the 16384 default crash-loops capture ("requires full packet
# captures"). 65536 covers any GRO super-frame.
snapLen=65536

# Max time between pcap rotations (minutes)
maxFileTimeM=60

# TCP/UDP/ICMP session timeouts
tcpTimeout=600
udpTimeout=30
icmpTimeout=10

# Packet threads
packetThreads=2

# Viewer port
viewPort=8005

# Log files
logFile=/opt/arkime/logs/viewer.log

# OUI (MAC vendor) and IANA address space
ouiFile=/opt/arkime/etc/oui.txt
ouiIpFile=/opt/arkime/etc/ipv4-address-space.csv

# GeoIP databases (MaxMind GeoLite2 — updated via geoipupdate)
geoLite2Country=/usr/share/GeoIP/GeoLite2-Country.mmdb
geoLite2ASN=/usr/share/GeoIP/GeoLite2-ASN.mmdb
geoLite2City=/usr/share/GeoIP/GeoLite2-City.mmdb

# Wise (threat intel) disabled by default
#wiseHost=127.0.0.1
