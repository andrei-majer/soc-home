#!/bin/bash
# Managed by Ansible
# Detect PPPoE IP change and update Suricata HOME_NET + reload rules.
# Run via cron every 5 minutes: */5 * * * * /usr/local/bin/update-wan-ip.sh

CACHE=/var/run/wan-ip.cache
YAML=/etc/suricata/suricata.yaml
LOG_TAG="update-wan-ip"

# Get current PPPoE IP from router
CURRENT_IP=$(ssh -o ConnectTimeout=5 -o BatchMode=yes root@{{ fail2ban_router_ip }} \
  "ip -4 addr show pppoe-wan 2>/dev/null | awk '/inet /{print \$2}' | cut -d/ -f1" 2>/dev/null)

if [ -z "$CURRENT_IP" ]; then
    logger -t "$LOG_TAG" "Could not retrieve WAN IP from router — skipping"
    exit 0
fi

CACHED_IP=$(cat "$CACHE" 2>/dev/null)

if [ "$CURRENT_IP" = "$CACHED_IP" ]; then
    exit 0  # No change
fi

logger -t "$LOG_TAG" "WAN IP changed: ${CACHED_IP:-none} → ${CURRENT_IP}"

# Update HOME_NET in suricata.yaml
# Replace any existing IP at end of HOME_NET list (after last comma up to closing bracket)
if grep -q "$CACHED_IP" "$YAML" 2>/dev/null; then
    sed -i "s/${CACHED_IP}/${CURRENT_IP}/g" "$YAML"
    logger -t "$LOG_TAG" "Replaced ${CACHED_IP} with ${CURRENT_IP} in suricata.yaml"
else
    # No old IP to replace — warn and skip yaml update (manual fix needed)
    logger -t "$LOG_TAG" "WARNING: old IP ${CACHED_IP} not found in suricata.yaml — update manually"
fi

# Save new IP to cache
echo "$CURRENT_IP" > "$CACHE"

# Reload Suricata rules (non-blocking, 600s timeout)
logger -t "$LOG_TAG" "Triggering Suricata rule reload..."
timeout 600 suricatasc -c "reload-rules" >/dev/null 2>&1 &
logger -t "$LOG_TAG" "Reload triggered (background PID $!)"
