[Unit]
Description=OpenCTI Docker Compose
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/opencti
ExecStartPre=/usr/bin/docker compose up --no-start
ExecStart=/usr/bin/docker compose start
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
