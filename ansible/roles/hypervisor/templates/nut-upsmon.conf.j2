MONITOR ted@localhost 1 monuser {{ vault_nut_monuser_password }} master
MINSUPPLIES 1

# The resilience loop is the SOLE shutdown authority. upsmon's own forced-shutdown
# (FSD) otherwise fires on stale state across a suspend and powers the host off after
# a clean resume — so SHUTDOWNCMD is deliberately a harmless no-op logger.
SHUTDOWNCMD "/usr/bin/logger -t upsmon-fsd FSD-ignored-resilience-loop-owns-shutdown"

POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
RBWARNTIME 43200
NOCOMMWARNTIME 300
FINALDELAY 5

# Route power events to upssched, which starts the resilience loop on ONBATT.
NOTIFYCMD /usr/sbin/upssched
NOTIFYFLAG ONLINE   SYSLOG+WALL+EXEC
NOTIFYFLAG ONBATT   SYSLOG+WALL+EXEC
NOTIFYFLAG LOWBATT  SYSLOG+WALL+EXEC
NOTIFYFLAG FSD      SYSLOG+WALL
NOTIFYFLAG SHUTDOWN SYSLOG+WALL
NOTIFYFLAG REPLBATT SYSLOG+WALL
NOTIFYFLAG COMMBAD  SYSLOG
NOTIFYFLAG COMMOK   SYSLOG
NOTIFYFLAG NOCOMM   SYSLOG+WALL
