# bootstrap/vagrant/Vagrantfile
# Reads specs.yml + mode override, defines per-VM config.
# Mode files (modes/dr.rb, modes/isolated.rb) own NIC and IP logic.

require 'yaml'
require 'fileutils'

SPECS_FILE = File.expand_path('specs.yml', __dir__)
MODE       = ENV.fetch('SOC_MODE', 'dr')
HOSTS_ENV  = ENV.fetch('SOC_HOSTS', '')         # comma-separated; empty = all
PROFILE    = ENV.fetch('SOC_PROFILE', 'full')   # full | minimal

abort "specs.yml not found at #{SPECS_FILE}" unless File.exist?(SPECS_FILE)
specs = YAML.load_file(SPECS_FILE)

# -Hosts filter
unless HOSTS_ENV.empty?
  wanted = HOSTS_ENV.split(',').map(&:strip)
  specs = specs.select { |k, _| wanted.include?(k) }
  abort "no specs match SOC_HOSTS=#{HOSTS_ENV}" if specs.empty?
end

# -Profile minimal scaling
if PROFILE == 'minimal'
  specs.each do |_, spec|
    spec['ram'] = [spec['ram'], 6144].min     # cap each VM at 6 GB
    spec['cpu'] = [spec['cpu'], 2].min
  end
end

mode_file = File.expand_path("modes/#{MODE}.rb", __dir__)
abort "unknown mode '#{MODE}' (no #{mode_file})" unless File.exist?(mode_file)
require mode_file
config_for_mode = SocLabMode

# Where to write Ansible inventory overrides
OVERRIDE_DIR = File.expand_path('../.vagrant/ansible-overrides/host_vars', __dir__)
FileUtils.mkdir_p(OVERRIDE_DIR)

# Read deploy SSH public key (must exist before vagrant up)
PUBKEY_FILE = File.expand_path('../secrets/id_ed25519.pub', __dir__)
abort "deploy public key missing at #{PUBKEY_FILE}" unless File.exist?(PUBKEY_FILE)
DEPLOY_PUBKEY = File.read(PUBKEY_FILE).strip

Vagrant.configure("2") do |config|
  config.vm.box = "soc-lab/debian-12"
  config.ssh.insert_key = false

  specs.each do |hostname, spec|
    config.vm.define hostname do |vm|
      vm.vm.hostname = hostname

      vm.vm.provider :virtualbox do |vb|
        vb.name   = hostname
        vb.memory = spec['ram']
        vb.cpus   = spec['cpu']

        if spec['disk'] && spec['disk'] > 20
          extra_disk = File.expand_path("../.vagrant/disks/#{hostname}-extra.vdi", __dir__)
          unless File.exist?(extra_disk)
            FileUtils.mkdir_p(File.dirname(extra_disk))
            vb.customize ['createmedium', 'disk',
                          '--filename', extra_disk,
                          '--size', (spec['disk'] - 20) * 1024,
                          '--format', 'VDI']
          end
          vb.customize ['storageattach', :id,
                        '--storagectl', 'SATA Controller',
                        '--port', '1',
                        '--device', '0',
                        '--type', 'hdd',
                        '--medium', extra_disk]
        end

        config_for_mode.apply_nics(vb, spec)
      end

      # First-boot shell provisioner: install deploy key + configure static IP on eth1.
      # The Packer image sets net.ifnames=0 so the second NIC is reliably eth1.
      vm.vm.provision "shell", inline: <<-SHELL, env: { 'DEPLOY_PUBKEY' => DEPLOY_PUBKEY }
        set -e
        echo "$DEPLOY_PUBKEY" >> /root/.ssh/authorized_keys
        sort -u /root/.ssh/authorized_keys -o /root/.ssh/authorized_keys
        chmod 0600 /root/.ssh/authorized_keys
        cat > /etc/network/interfaces.d/eth1 <<EOF
auto eth1
iface eth1 inet static
  address #{spec['ip']}
  netmask 255.255.255.0
EOF
        if [ "#{MODE}" = "dr" ]; then
          cat >> /etc/network/interfaces.d/eth1 <<EOF
  gateway 192.168.1.1
  dns-nameservers 192.168.1.1
EOF
        fi
        ifup eth1 || systemctl restart networking
      SHELL

      override_path = File.join(OVERRIDE_DIR, hostname)
      FileUtils.mkdir_p(override_path)
      File.write(File.join(override_path, 'bootstrap.yml'),
        "---\nansible_host: #{spec['ip']}\n")
    end
  end
end
